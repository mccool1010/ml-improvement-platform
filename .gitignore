# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Data: raw and derived data are reproducible from scripts/download_data.py
data/raw/*
data/interim/*
data/processed/*
!data/**/.gitkeep
!data/README.md

# ML lifecycle artifacts.
# These patterns are anchored with a leading slash so they match only at the
# repository root. An unanchored `models/` also matched src/ml_platform/models/,
# which silently excluded the entire modelling package from version control. The
# working tree was fine and a fresh clone could not import ml_platform.models.
/mlruns/
/mlartifacts/
/mlflow.db
/models/
*.joblib
*.pkl
/optuna.db

# Run records and benchmarks ARE the project's evidence, so they are tracked.
#
# Promotion reports are the exception. `promote` writes one per invocation, which
# left the working tree dirty and made the *next* run fail the reproducibility
# gate. The gate is correct and stays as it is; the churn is what gets ignored.
# Reports already committed as M6 evidence remain tracked.
/artifacts/benchmarks/promotion-*.json
# Model binaries are not: they are large and rebuildable from a tracked record.

# Local env / editor
/.env
.env.*
!.env.example
.idea/
.vscode/
.DS_Store

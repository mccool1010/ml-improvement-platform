# Everything the image does not need. Keeping this tight matters for more than
# size: the raw register is 179 MB, and the MLflow store would bake one
# particular registry state into an image that should be able to serve any.

.git/
.github/
.venv/

# Data and stores. The register is for training; the API only scores. The MLflow
# store is mounted at run time so a promotion needs no rebuild.
data/
mlruns/
mlartifacts/
mlflow.db
models/
*.joblib
*.pkl
optuna.db

# Evidence and development material
artifacts/
notebooks/
docs/
tests/
scripts/
k8s/
monitoring/

# Caches and local state
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
.env
.env.*
.idea/
.vscode/
.DS_Store

# The dashboard is compiled in its own build stage from source plus the
# lockfile. A local node_modules or dist must never enter the build context:
# node_modules is large and platform-specific, and a stale dist would be copied
# over the freshly built one.
dashboard/node_modules/
dashboard/dist/

# The image builds from the Dockerfile; it does not need a copy of itself.
docker/
Makefile
